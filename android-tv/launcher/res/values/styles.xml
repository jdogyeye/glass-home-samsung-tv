<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Full screen, black until the first photo is decoded, no window
         animations of its own (the system's still apply). -->
    <style name="Home" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorAccent">#ffffff</item>
    </style>
</resources>
